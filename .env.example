# No quotes around values: Docker's --env-file keeps them.

# OpenAI (required; read implicitly by langchain_openai)
OPENAI_API_KEY=

# Model names (required, no defaults; see research_agent/config.py)
LLM_MODEL=
EMBEDDING_MODEL=

# Optional overrides (defaults shown)
COLLECTION_NAME=annual_reports_1600
MAX_RUNS_PER_DAY=20

# LangSmith tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
